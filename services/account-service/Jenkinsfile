// Jenkinsfile for account-service
@Library('banking-shared-library') _

pipeline {
    agent any

    environment {
        SERVICE_NAME = 'account-service'
        IMAGE_NAME   = "myregistry/${SERVICE_NAME}"
        IMAGE_TAG    = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Install Dependencies') {
            steps {
                dir('services/account-service') { sh 'npm install' }
            }
        }

        stage('Run Tests') {
            steps {
                dir('services/account-service') { sh 'npm test' }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                buildAndPushImage(
                    servicePath: 'services/account-service',
                    imageName: "${IMAGE_NAME}",
                    imageTag: "${IMAGE_TAG}"
                )
            }
        }

        stage('Trigger CD') {
            steps {
                echo "Notifying CD pipeline to deploy ${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }
    }

    post {
        success { echo "account-service pipeline completed successfully." }
        failure { echo "account-service pipeline failed - check logs above." }
    }
}
